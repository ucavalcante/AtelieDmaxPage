{
  "name": "ateliedmaxpage",
  "version": "0.9.0",
  "description": "Portfolio website for Ateliê Dmax - artesanato em MDF, costura e bordados eletrônicos. Featuring TypeScript/Vue.js architecture with responsive design and auto-image detection.",
  "main": "index.html",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report test-results/html-report",
    "build": "node scripts/generate-manifest.js && npx tsc",
    "build:watch": "npx tsc --watch",
    "check": "npx tsc --noEmit",
    "dev": "npm run build:watch",
    "build:clean": "find js/ -name '*.js' ! -name '.gitkeep' -delete && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ucavalcante/AtelieDmaxPage.git"
  },
  "author": "Ulises Cavalcante",
  "keywords": [
    "artesanato",
    "mdf",
    "bordado eletrônico",
    "costura",
    "enxoval bebê",
    "convites personalizados",
    "typescript",
    "vue.js",
    "portfolio",
    "github-pages"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ucavalcante/AtelieDmaxPage/issues"
  },
  "homepage": "https://github.com/ucavalcante/AtelieDmaxPage#readme",
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
